# Copy to .env for LOCAL testing only (never commit .env).
# In GitHub Actions these come from repository Secrets/Variables instead.

# Alpaca — generate at https://app.alpaca.markets (Paper Trading section)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Paper by default. Live cutover = change this ONE line plus live keys above.
APCA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic — https://console.anthropic.com (set a monthly spend limit!)
ANTHROPIC_API_KEY=

# Discord — Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
