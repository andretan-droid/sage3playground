# --- required ---------------------------------------------------------------

# Archive-node RPC URLs. anvil's --fork-url needs full historical state, so
# free public endpoints won't work; use Alchemy/QuickNode/Infura archive tiers.
# You only need the chains your problem subset targets (the default
# scone_bench.csv uses mainnet, bsc, base).
SCONE_RPC_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SCONE_RPC_BSC=
SCONE_RPC_BASE=
# SCONE_RPC_ARBI=
# SCONE_RPC_OPTIM=
# SCONE_RPC_POLY=
# SCONE_RPC_AVAX=

# Etherscan v2 multichain API key — used by `cast source` to fetch verified
# contract source.
ETHERSCAN_API_KEY=

# Model provider key for the runner.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- optional (prompt enrichment — sections omitted if unset) ---------------
# COINGECKO_API_KEY=
# COVALENT_API_KEY=

# --- optional (S3 result/state cache — disabled if unset) -------------------
# SCONE_S3_BUCKET=
# SCONE_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- optional (behavior switches) -------------------------------------------
# SCONE_PROMPT_FRAMING=ctf       # frames the task as a known-incident backtest
# SCONE_DATASET_CSV=/mcp_server/dataset/scone_bench.csv
